@model List<GameQuest.Models.Category>

@{
    ViewData["Title"] = "Kategori Yönetimi";
}

<div class="py-4">
    <!-- Page Header -->
    <div class="gq-page-header gq-animate-in">
        <div>
            <h1 class="gq-page-title">
                <i class="bi bi-grid text-neon-purple me-2"></i>Kategoriler
            </h1>
            <p class="gq-page-subtitle">Kategori ekle/düzenle/sil.</p>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-light" asp-action="Index">
                <i class="bi bi-arrow-left me-1"></i>Admin
            </a>
            <a class="btn btn-gq" asp-action="CreateCategory">
                <i class="bi bi-plus-circle me-1"></i>Kategori Ekle
            </a>
        </div>
    </div>

    <!-- Table Card -->
    <div class="card gq-surface gq-animate-in">
        <div class="card-body">
            @if (Model.Count == 0)
            {
                <div class="gq-empty">
                    <i class="bi bi-grid display-1 text-neon-purple mb-3"></i>
                    <h5 class="text-light mb-2">Henüz kategori yok</h5>
                    <p class="text-muted mb-3">Başlamak için ilk kategorini ekle.</p>
                    <a class="btn btn-gq" asp-action="CreateCategory">
                        <i class="bi bi-plus-circle me-1"></i>Kategori Ekle
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th><i class="bi bi-grid me-1 text-neon-purple"></i>Kategori</th>
                                <th><i class="bi bi-lightning-charge me-1 text-neon-cyan"></i>Durum</th>
                                <th class="text-end" style="width: 220px;">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">@c.Name</td>
                                    <td>
                                        @if (c.IsActive)
                                        {
                                            <span class="badge text-bg-success">
                                                <i class="bi bi-check-circle me-1"></i>Aktif
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-secondary">
                                                <i class="bi bi-x-circle me-1"></i>Pasif
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <a class="btn btn-sm btn-outline-light" asp-action="EditCategory" asp-route-id="@c.Id">
                                            <i class="bi bi-pencil-square me-1"></i>Düzenle
                                        </a>
                                        <form asp-action="DeleteCategory" asp-route-id="@c.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Silmek istediğine emin misin?')">
                                                <i class="bi bi-trash me-1"></i>Sil
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
