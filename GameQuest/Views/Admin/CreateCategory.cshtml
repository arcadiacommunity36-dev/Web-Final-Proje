@model GameQuest.ViewModels.AdminCategoryEditViewModel

@{
    ViewData["Title"] = "Kategori Ekle";
}

<div class="py-4">
    <!-- Page Header -->
    <div class="gq-page-header gq-animate-in">
        <div>
            <h1 class="gq-page-title">
                <i class="bi bi-plus-circle text-neon-cyan me-2"></i>Kategori Ekle
            </h1>
            <p class="gq-page-subtitle">Yeni kategori oluştur.</p>
        </div>
        <a class="btn btn-outline-light" asp-action="Categories">
            <i class="bi bi-arrow-left me-1"></i>Geri
        </a>
    </div>

    <!-- Form Card -->
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="card gq-surface gq-animate-in">
                <div class="card-body">
                    <form asp-action="CreateCategory" method="post" class="row g-3">
                        @Html.AntiForgeryToken()

                        <div class="col-12">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <div class="form-check">
                                <input class="form-check-input" asp-for="IsActive" />
                                <label class="form-check-label" asp-for="IsActive"></label>
                            </div>
                            <span asp-validation-for="IsActive" class="text-danger"></span>
                        </div>

                        <div class="col-12 d-flex gap-2 pt-2">
                            <button class="btn btn-gq" type="submit">
                                <i class="bi bi-check-circle me-1"></i>Kaydet
                            </button>
                            <a class="btn btn-outline-light" asp-action="Categories">
                                <i class="bi bi-x-circle me-1"></i>İptal
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
