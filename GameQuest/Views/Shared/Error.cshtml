@model ErrorViewModel
@{
    ViewData["Title"] = "Hata";
}

<div class="row justify-content-center py-5">
    <div class="col-md-6">
        <div class="gq-surface p-4 p-md-5 rounded-4 border shadow-lg border-danger border-opacity-25 text-center">
            <h1 class="h2 fw-bold text-danger mb-3">Hata.</h1>
            <h2 class="h5 mb-4">İsteğin işlenmesi sırasında bir hata oluştu.</h2>
            
            @if (Model.ShowRequestId)
            {
                <div class="alert alert-dark border-danger border-opacity-25 mb-4 text-start">
                    <strong>İstek Kimliği:</strong> <code class="text-neon-cyan">@Model.RequestId</code>
                </div>
            }
            
            <p class="text-muted small text-start">
                <strong>Geliştirme Modu:</strong> Ortamı Development olarak değiştirirsen daha detaylı bilgi görüntülenir.
                Yayınlanan uygulamalarda bu kapalı olmalıdır. Yerel hata ayıklama için ASPNETCORE_ENVIRONMENT değişkenini kullanabilirsin.
            </p>
        </div>
    </div>
</div>
